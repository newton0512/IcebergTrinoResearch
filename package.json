{
  "name": "@mkven/samples-generation",
  "version": "0.4.4",
  "description": "Generate sample data for PostgreSQL, ClickHouse, SQLite, and Trino with a unified interface",
  "author": "Damir Manapov",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "data-generation",
    "sample-data",
    "test-data",
    "postgresql",
    "clickhouse",
    "sqlite",
    "trino",
    "database",
    "faker",
    "mock-data"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/making-ventures/samples-generation.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepublishOnly": "pnpm run build",
    "dev": "tsx src/index.ts",
    "test": "vitest run",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "test:watch": "vitest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "release": "release-it",
    "release:dry": "release-it --dry-run",
    "compose:up": "docker compose -f compose/docker-compose.yml --profile single up starter",
    "compose:postgres": "docker compose -f compose/docker-compose.yml up -d postgres",
    "compose:clickhouse": "docker compose -f compose/docker-compose.yml up -d clickhouse",
    "compose:trino": "docker compose -f compose/docker-compose.yml up -d trino",
    "compose:trino-fte": "docker compose -f compose/docker-compose.yml up -d trino-fte",
    "compose:rabbitmq": "docker compose -f compose/docker-compose.yml up -d rabbitmq",
    "compose:down": "docker compose -f compose/docker-compose.yml down",
    "compose:restart": "docker compose -f compose/docker-compose.yml restart",
    "compose:reset": "docker compose -f compose/docker-compose.yml down --volumes --remove-orphans",
    "worker": "tsx src/hybrid-writer/worker.ts",
    "worker:dev": "tsx watch src/hybrid-writer/worker.ts",
    "test:hybrid-writer": "tsx test-hybrid-writer/index.ts",
    "queue-worker": "tsx scripts/queue-worker.ts",
    "queue-worker:dev": "tsx watch scripts/queue-worker.ts",
    "write:queue": "tsx scripts/write-with-queue.ts",
    "setup:tables": "tsx scripts/setup-tables.ts",
    "write:trino-mass": "tsx scripts/write-trino-mass.ts",
    "partitioning:create": "tsx scripts/partitioning-create-tables.ts",
    "partitioning:ensure-fill": "tsx scripts/partitioning-ensure-and-fill.ts",
    "partitioning:bench": "tsx scripts/partitioning-read-benchmark.ts",
    "api:server": "tsx src/api/server.ts",
    "api:dev": "tsx watch src/api/server.ts",
    "k6:run": "bash k6-run-pipe.sh",
    "k6:test": "bash k6-run-pipe.sh test-simple.js",
    "k6:test-health": "bash k6-run-pipe.sh test-health.js",
    "k6:postgres": "bash k6-run-pipe.sh k6-scripts/postgres-direct.js",
    "k6:trino": "bash k6-run-pipe.sh k6-scripts/trino-direct.js",
    "k6:write": "bash k6-run-pipe.sh k6-scripts/write-cycle.js",
    "k6:consistency": "bash k6-run-pipe.sh k6-scripts/consistency-check.js",
    "k6:analytics": "bash k6-run-pipe.sh k6-scripts/analytics-queries.js",
    "k6:read-delay": "bash k6-run-pipe.sh k6-scripts/read-delay.js",
    "k6:real-load": "bash k6-run-pipe.sh k6-scripts/real-load.js",
    "k6:all": "bash k6-scripts/run-all.sh"
  },
  "dependencies": {
    "@clickhouse/client": "^1.15.0",
    "@mkven/name-dictionaries": "^0.1.0",
    "@types/amqplib": "^0.10.8",
    "amqplib": "^0.10.9",
    "better-sqlite3": "^12.5.0",
    "express": "^4.18.2",
    "pg-format": "^1.0.4",
    "postgres": "^3.4.7",
    "trino-client": "^0.2.9"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@faker-js/faker": "^10.1.0",
    "@release-it/conventional-changelog": "^10.0.4",
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^4.17.21",
    "@types/node": "^25.0.3",
    "@types/pg-format": "^1.0.5",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.7.4",
    "release-it": "^19.2.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.50.1",
    "vitest": "^4.0.16"
  }
}
