#cloud-config

package_update: true
package_upgrade: true

packages:
  - ca-certificates
  - curl
  - git
  - jq
  - docker.io
  - docker-compose-plugin
  - netcat-openbsd

runcmd:
  - |
    set -euo pipefail

    echo "==> Installing Node.js (20.x) + pnpm"
    curl -fsSL https://deb.nodesource.com/setup_20.x | bash -
    apt-get install -y nodejs
    corepack enable
    corepack prepare pnpm@latest --activate

    echo "==> Enabling Docker"
    systemctl enable docker
    systemctl start docker

    echo "==> Cloning repo"
    REPO_URL="${repo_url}"
    REPO_REF="${repo_ref}"
    REPO_SUBDIR="${repo_subdir}"
    REPO_DIR="/opt/IcebergTrinoResearch"

    if [ ! -d "$REPO_DIR/.git" ]; then
      git clone --depth 1 --branch "$REPO_REF" "$REPO_URL" "$REPO_DIR"
    else
      cd "$REPO_DIR"
      git fetch --all --prune
      git checkout "$REPO_REF"
      git reset --hard "origin/$REPO_REF" || true
    fi

    cd "$REPO_DIR/$REPO_SUBDIR"

    echo "==> Installing dependencies"
    pnpm install

    DATA_IP="${data_server_private_ip}"

    echo "==> Writing environment file"
    cat > /etc/samples-generation.env <<EOF
POSTGRES_HOST=$DATA_IP
POSTGRES_PORT=5432
POSTGRES_DB=appdb
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

TRINO_HOST=$DATA_IP
TRINO_PORT=8080
TRINO_CATALOG=iceberg
TRINO_SCHEMA=warehouse
TRINO_USER=trino
TRINO_TABLE=bonus_registry

API_PORT=3000
EOF

    echo "==> Creating systemd services (API + queue worker)"
    cat > /etc/systemd/system/samples-api.service <<'EOF'
[Unit]
Description=samples-generation API server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/IcebergTrinoResearch/${repo_subdir}
EnvironmentFile=/etc/samples-generation.env
ExecStart=/usr/bin/pnpm run api:server
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
EOF

    cat > /etc/systemd/system/samples-queue-worker.service <<'EOF'
[Unit]
Description=samples-generation trino_queue worker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/IcebergTrinoResearch/${repo_subdir}
EnvironmentFile=/etc/samples-generation.env
ExecStart=/usr/bin/pnpm run queue-worker
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
EOF

    # One-shot: wait for Data server and setup tables
    cat > /etc/systemd/system/samples-setup.service <<'EOF'
[Unit]
Description=Initialize Postgres + Trino tables for samples-generation
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/IcebergTrinoResearch/${repo_subdir}
EnvironmentFile=/etc/samples-generation.env
ExecStart=/bin/bash -lc '\
  set -euo pipefail; \
  echo \"Waiting for Postgres on $POSTGRES_HOST:5432\"; \
  until nc -z \"$POSTGRES_HOST\" 5432; do sleep 2; done; \
  echo \"Waiting for Trino on $TRINO_HOST:8080\"; \
  until curl -fs \"http://$TRINO_HOST:8080/v1/info\" >/dev/null 2>&1; do sleep 2; done; \
  pnpm run setup:tables \
'
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
EOF

    systemctl daemon-reload
    systemctl enable samples-api.service
    systemctl enable samples-queue-worker.service
    systemctl enable samples-setup.service

    systemctl start samples-setup.service || true
    systemctl start samples-api.service
    systemctl start samples-queue-worker.service

    touch /root/cloud-init-ready-load
    echo "==> Ready: /root/cloud-init-ready-load"

final_message: "Load Test Server ready: repo cloned, pnpm installed, api+worker running."
