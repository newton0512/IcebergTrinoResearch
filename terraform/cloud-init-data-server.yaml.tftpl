#cloud-config

package_update: true
package_upgrade: true

packages:
  - ca-certificates
  - curl
  - git
  - jq
  - docker.io
  - docker-compose-plugin

runcmd:
  - |
    set -euo pipefail

    echo "==> Preparing data disk (if present)"
    DATA_DEV="$(lsblk -dn -o NAME,TYPE,MOUNTPOINT | awk '$2=="disk" && $3=="" {print "/dev/"$1; exit}')"
    if [ -n "$DATA_DEV" ] && [ -b "$DATA_DEV" ]; then
      echo "Found candidate data disk: $DATA_DEV"
      if ! blkid "$DATA_DEV" >/dev/null 2>&1; then
        mkfs.ext4 -F "$DATA_DEV"
      fi
      mkdir -p /data
      UUID="$(blkid -s UUID -o value "$DATA_DEV")"
      if ! grep -q "$UUID" /etc/fstab; then
        echo "UUID=$UUID /data ext4 defaults,nofail 0 2" >> /etc/fstab
      fi
      mount -a
    else
      echo "No extra data disk found, using root filesystem"
      mkdir -p /data
    fi

    mkdir -p /data/minio /data/postgres /data/nessie

    echo "==> Enabling Docker"
    systemctl enable docker
    systemctl start docker

    echo "==> Cloning repo"
    REPO_URL="${repo_url}"
    REPO_REF="${repo_ref}"
    REPO_SUBDIR="${repo_subdir}"
    REPO_DIR="/opt/IcebergTrinoResearch"

    if [ ! -d "$REPO_DIR/.git" ]; then
      git clone --depth 1 --branch "$REPO_REF" "$REPO_URL" "$REPO_DIR"
    else
      cd "$REPO_DIR"
      git fetch --all --prune
      git checkout "$REPO_REF"
      git reset --hard "origin/$REPO_REF" || true
    fi

    cd "$REPO_DIR/$REPO_SUBDIR"

    echo "==> Writing docker-compose override for Linux volumes"
    cat > compose/docker-compose.override.yml <<'EOF'
services:
  postgres:
    volumes:
      - /data/postgres:/var/lib/postgresql/data
  minio:
    volumes:
      - /data/minio:/data
  nessie:
    volumes:
      - /data/nessie:/var/lib/nessie
EOF

    echo "==> Tuning Trino config for this VM"
    cat > compose/trino/jvm.config <<'EOF'
-Xmx${trino_heap_gb}G
-XX:+UseG1GC
-XX:G1HeapRegionSize=32M
-XX:+ExplicitGCInvokesConcurrent
-XX:+HeapDumpOnOutOfMemoryError
-XX:HeapDumpPath=/tmp/trino-heap-dump.hprof
-XX:ReservedCodeCacheSize=512M
-Djdk.attach.allowAttachSelf=true
-XX:+ExitOnOutOfMemoryError
-XX:MaxDirectMemorySize=${trino_max_direct_memory_gb}G
EOF

    # Под coordinator-only режим
    MAX_MEM_GB=$(( ${trino_heap_gb} - 8 ))
    if [ "$MAX_MEM_GB" -lt 1 ]; then MAX_MEM_GB=1; fi

    cat > compose/trino/config.properties <<EOF
coordinator=true
node-scheduler.include-coordinator=true
node.environment=selectel
http-server.http.port=8080

query.max-memory=$${MAX_MEM_GB}GB
query.max-memory-per-node=$${MAX_MEM_GB}GB
memory.heap-headroom-per-node=4GB

http-server.http.acceptor-threads=4
http-server.http.selector-threads=8
http-server.threads.max=400
http-server.threads.min=50

query.client.timeout=2h

task.concurrency=8
task.max-worker-threads=32
EOF

    echo "==> Starting services (postgres, minio, nessie, trino)"
    docker compose -f compose/docker-compose.yml up -d postgres minio create-minio-bucket create-nessie-db nessie create-nessie-ref trino

    echo "==> Waiting for services to become ready"
    until docker compose -f compose/docker-compose.yml exec -T postgres pg_isready -U postgres >/dev/null 2>&1; do sleep 2; done
    until curl -fs http://localhost:19120/api/v2/config >/dev/null 2>&1; do sleep 2; done
    until curl -fs http://localhost:8080/v1/info >/dev/null 2>&1; do sleep 2; done

    echo "==> Enabling pgcrypto extension in appdb"
    docker compose -f compose/docker-compose.yml exec -T postgres psql -U postgres -d appdb -c "CREATE EXTENSION IF NOT EXISTS pgcrypto;" >/dev/null

    touch /root/cloud-init-ready-data
    echo "==> Ready: /root/cloud-init-ready-data"

final_message: "Data Server ready: Docker stack started, Trino/MinIO/Nessie/Postgres up."
